    todo("agent-proto-nv.agpsession.with_tools")

// The capabilities with resources turned on.
pub fn with_resources(c: AgpCapabilities, list_changed: Bool, subscribe: Bool) -> AgpCapabilities []
    todo("agent-proto-nv.agpsession.with_resources")

// The capabilities with prompts turned on.
pub fn with_prompts(c: AgpCapabilities, list_changed: Bool) -> AgpCapabilities []
    todo("agent-proto-nv.agpsession.with_prompts")

// The capabilities with sampling turned on.
pub fn with_sampling(c: AgpCapabilities) -> AgpCapabilities []
    todo("agent-proto-nv.agpsession.with_sampling")

// The capabilities with roots turned on.
pub fn with_roots(c: AgpCapabilities, list_changed: Bool) -> AgpCapabilities []
    todo("agent-proto-nv.agpsession.with_roots")

// The capabilities with logging turned on.
pub fn with_logging(c: AgpCapabilities) -> AgpCapabilities []
    todo("agent-proto-nv.agpsession.with_logging")

// Whether a capability name is declared, by name.
//
// The bridge from `McpClient.capabilities`, which answers a `[Str]`:
// a caller holding those strings can ask this rather than comparing
// them itself.
pub fn has_capability(c: AgpCapabilities, name: Str) -> Bool []
    todo("agent-proto-nv.agpsession.has_capability")

// Every capability the peer declared, as the names the protocol uses.
//
// The other direction, for a caller that has to report or log what a
// peer offered.
pub fn capability_names(c: AgpCapabilities) -> [Str] []
    todo("agent-proto-nv.agpsession.capability_names")

// ── Versions ─────────────────────────────────────────────────────────

// The protocol revisions this package implements, newest first.
//
// Data rather than a constant in prose, because a caller that has to
// interoperate with an older peer needs the list and because the test
// suite asserts it against what the toolchain actually speaks.
pub fn versions_supported() -> [Str] []
    todo("agent-proto-nv.agpsession.versions_supported")

// The newest revision this package implements.
//
// What a client proposes in `initialize` when it has no reason to
// propose otherwise.
pub fn latest_version() -> Str []
    todo("agent-proto-nv.agpsession.latest_version")

// The revision the standard library's `McpClient` speaks today:
// `2024-11-05`.
//
// PUBLISHED AS A FUNCTION AND NOT AS A SENTENCE, because it is the one
// fact that decides whether a program built on `std.mcp` and one built
// on this package can talk to the same server without a negotiation
// surprise. When the stdlib moves, this moves with it and the test
// that compares the two fails until it does.
pub fn stdlib_version() -> Str []
    todo("agent-proto-nv.agpsession.stdlib_version")

// Whether this package implements a revision.
pub fn supports_version(v: Str) -> Bool []
    todo("agent-proto-nv.agpsession.supports_version")

// The version a client should settle on, given what it proposed and
// what the server answered.
//
// THE NEGOTIATION RULE, IN ONE CALL.  A client proposes its newest; a
// server answers with a version it supports, which may be OLDER and
// may be one the client cannot speak. `AgpVersionRejected` carrying
// both strings is the third case, and it is the one where the right
// move is to disconnect rather than to carry on hopefully.
pub fn negotiate(proposed: Str, offered: Str) -> Result<Str, agperror.AgpFault> []
    todo("agent-proto-nv.agpsession.negotiate")

// Whether a method exists at a negotiated revision.
//
// A later revision adds methods, and a peer at an earlier one answers
// `-32601` for them. Asking before sending turns a round trip into a
// local check.
pub fn method_in_version(method: Str, version: Str) -> Bool []
    todo("agent-proto-nv.agpsession.method_in_version")

// ── The call this module exists for ──────────────────────────────────

// Whether this side may send this method right now.
//
// THE LOAD-BEARING CALL OF THIS PACKAGE.  Three things decide it: the
// state, the negotiated version, and the capabilities the peer
// declared — and none of the three is visible in the message.
//
// ```novo ignore
// match agpsession.may_send(s, "tools/list")
//     AgpAllow            => send(agptool.list_request(next_id()))
//     AgpNotYet(state)    => println("not yet: ${state}")
//     AgpNotOffered(cap)  => println("this server has no ${cap}")
// ```
pub fn may_send(s: AgpSession, method: Str) -> AgpAllowed []
    todo("agent-proto-nv.agpsession.may_send")

// Whether this side may RECEIVE this method right now.
//
// The other half, and not the same question: MCP is bidirectional, so
// a client that received `tools/list` has met a peer doing something
// wrong, and answering it politely would be worse than refusing.
pub fn may_receive(s: AgpSession, method: Str) -> AgpAllowed []
    todo("agent-proto-nv.agpsession.may_receive")

// Every method this side may send right now.
//
// For a caller building a menu, and for the test that says the
// handshake opened the session rather than only changing a field.
pub fn allowed_methods(s: AgpSession) -> [Str] []
    todo("agent-proto-nv.agpsession.allowed_methods")

// ── Moving the state ─────────────────────────────────────────────────

// The session after a message has been sent.
//
// `AgpWrongState` when `may_send` would have refused it, so a caller
// that skipped the check still cannot get a session into a state the
// protocol does not have. `AgpDuplicateId` when the id is already
// outstanding, because two requests with one id make the second answer
// unattributable.
pub fn sent(s: AgpSession, m: agpwire.AgpMessage) -> Result<AgpSession, agperror.AgpFault> []
    todo("agent-proto-nv.agpsession.sent")

// The session after a message has been received.
//
// This is where the `initialize` result lands: the negotiated version
// and the peer's capabilities come off it and into the session, which
// is what moves `AgpInitializing` to `AgpInitialized`.
//
// `AgpUnknownId` when a response matches no outstanding request — a
// duplicate answer, or one after a cancellation. The right move is to
// DROP it, which is why it is a fault a caller can distinguish rather
// than a session that fails.
pub fn received(s: AgpSession, m: agpwire.AgpMessage) -> Result<AgpSession, agperror.AgpFault> []
    todo("agent-proto-nv.agpsession.received")

// The session after a shutdown has begun.
//
// A transport-level event rather than a message: stdio closes a pipe,
// HTTP closes a connection, and neither sends anything. So it is a
// call rather than a `sent`.
pub fn closing(s: AgpSession) -> AgpSession []
    todo("agent-proto-nv.agpsession.closing")

// The session after the connection is gone.
pub fn closed(s: AgpSession) -> AgpSession []
    todo("agent-proto-nv.agpsession.closed")

// ── Reading a session ────────────────────────────────────────────────

// Whether the handshake is complete and ordinary traffic may flow.
pub fn is_ready(s: AgpSession) -> Bool []
    todo("agent-proto-nv.agpsession.is_ready")

// The state's name, for a log line and for `AgpNotYet`.
pub fn state_name(st: AgpState) -> Str []
    todo("agent-proto-nv.agpsession.state_name")

// How many requests are outstanding.
//
// The number a caller draining a connection waits down to zero, and
// the one a test asserts to show a response was matched rather than
// dropped.
pub fn outstanding_count(s: AgpSession) -> Int []
    todo("agent-proto-nv.agpsession.outstanding_count")

// Whether an id is outstanding.
pub fn is_outstanding(s: AgpSession, id: agpwire.AgpId) -> Bool []
    todo("agent-proto-nv.agpsession.is_outstanding")

// ── The handshake, as messages ───────────────────────────────────────

// The `initialize` request this side should send.
//
// Carries the proposed version, this side's capabilities and its own
// name — all three of which are already on the session, which is why
// this takes only an id.
pub fn initialize_request(s: AgpSession, id: agpwire.AgpId,
                          info: AgpPeerInfo) -> agpwire.AgpMessage []
    todo("agent-proto-nv.agpsession.initialize_request")

// The `initialize` result a server should answer with.
pub fn initialize_result(s: AgpSession, id: agpwire.AgpId, version: Str,
                         info: AgpPeerInfo) -> agpwire.AgpMessage []
    todo("agent-proto-nv.agpsession.initialize_result")

// The `notifications/initialized` a client must send after it has the
// result.
//
// Its own call because it is the step a client skips: the session
// looks connected without it and the server is entitled to send
// nothing.
pub fn initialized_notification() -> agpwire.AgpMessage []
    todo("agent-proto-nv.agpsession.initialized_notification")

// Whether the handshake still owes a message.
//
// True in `AgpInitialized`, where the client has the result and has
// not sent the notification. The predicate that turns "my server never
// sends anything" into a line a caller can assert.
pub fn handshake_incomplete(s: AgpSession) -> Bool []
    todo("agent-proto-nv.agpsession.handshake_incomplete")

// The capabilities a peer's `initialize` params or result declared.
//
// Published because a server reading a client's `initialize` needs
// exactly this, and because a caller that logged the raw JSON would
// otherwise write the same walk.
pub fn capabilities_of(v: JsonValueH) -> AgpCapabilities []
    todo("agent-proto-nv.agpsession.capabilities_of")

// The peer information an `initialize` message declared.
pub fn peer_info_of(v: JsonValueH) -> AgpPeerInfo []
    todo("agent-proto-nv.agpsession.peer_info_of")
