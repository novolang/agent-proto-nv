// agpsession.nv — the state machine as a value.  This module is the
// package's load-bearing interface.
//
// Every body here is a `todo()`; the signatures are the design.
//
// MCP's REAL FAILURE MODE IS ORDERING, AND NO MESSAGE TYPE SHOWS IT.
// A well-formed `tools/list` sent before `initialize` has been answered
// is a valid JSON-RPC request with a valid method and valid params,
// and it is wrong.  A server that sends a request before the client's
// `notifications/initialized` has arrived is wrong the same way.  A
// request after a shutdown is wrong.  None of that is visible in the
// message — it is visible only in what has already happened — so a
// library whose whole surface is message types leaves its callers to
// rediscover the sequence one hung connection at a time.
//
// So the session is a VALUE, and `may_send` answers before a byte
// reaches a socket:
//
//   let s = agpsession.client_session()
//   agpsession.may_send(s, "tools/list")   // AgpNotYet — initialize first
//
// AND THAT IS WHY IT IS TRANSPORT-INDEPENDENT.  MCP runs over stdio,
// over SSE and over streamable HTTP.  Three framings, three sets of
// connection lifecycle problems — and ONE state machine, identical in
// all of them.  Putting it in a `core` package with no transport is
// what lets the same value be checked in a unit test, driven by a
// subprocess client, and reused by a server.
//
// THE VERSION IS PART OF THE STATE, not a field beside it.  What may
// be sent depends on what was agreed: a capability the peer did not
// declare is not available, and a method a later revision introduced
// is not available at an earlier one.  So negotiation moves the state
// and `may_send` reads both.
//
// WHAT THIS IS NOT: a scheduler.  The session tracks what is
// OUTSTANDING so a response can be matched and a duplicate id refused;
// it does not decide what to send next, time anything out, or retry.
// A `core` package has no clock, and the caller that has one is better
// placed to decide.

use agperror
use agpwire

// Where a connection is in its lifecycle.
pub enum AgpState
    // Nothing has been sent.  Only `initialize` may go out.
    AgpFresh
    // `initialize` is outstanding.  Nothing else may be sent — which
    // is the rule an eager client breaks first.
    AgpInitializing
    // The peer answered `initialize` and the client has not yet sent
    // `notifications/initialized`.
    //
    // A state of its own because the specification puts a real
    // obligation in it: the client must send that notification, and a
    // server is entitled to wait for it before it sends anything of
    // its own.  A client that skipped it has a session that looks
    // connected and receives nothing.
    AgpInitialized
    // Both sides are ready.  Everything the negotiated capabilities
    // allow may be sent.
    AgpReady
    // A shutdown has begun.  Nothing new may be sent; outstanding
    // responses may still arrive.
    AgpClosing
    // The connection is over, by shutdown or by a fatal fault.
    AgpClosed

// Whether a call is allowed, and why not when it is not.
//
// Three answers rather than a boolean, because the two refusals lead a
// caller to opposite actions: `AgpNotYet` means finish the handshake
// and try again, `AgpNotOffered` means this peer will never do it and
// the caller should stop asking.
pub enum AgpAllowed
    // Send it.
    AgpAllow
    // Legal for this peer, but not in this state.  Carries the state,
    // so a log line says what to wait for.
    AgpNotYet(state: Str)
    // The peer did not declare the capability this method needs, or
    // the negotiated version does not have it.  Carries the capability
    // name.
    AgpNotOffered(capability: Str)

// What one side of a connection says it can do.
//
// A struct of named booleans rather than a `[Str]` of capability
// names, which is what the standard library's `McpClient.capabilities`
// answers today: a typo in a string is a capability silently absent,
// and a caller that wrote `"tool"` gets `false` with no complaint.
pub struct AgpCapabilities
    // The peer offers tools.
    tools: Bool
    // The peer will notify when its tool list changes.
    tools_list_changed: Bool
    // The peer offers resources.
    resources: Bool
    // The peer will notify when its resource list changes.
    resources_list_changed: Bool
    // The peer supports subscribing to a resource.
    resources_subscribe: Bool
    // The peer offers prompts.
    prompts: Bool
    // The peer will notify when its prompt list changes.
    prompts_list_changed: Bool
    // The peer will sample from a model on request — a SERVER asking a
    // CLIENT, which is the direction people are surprised by.
    sampling: Bool
    // The peer will answer a request for its roots.
    roots: Bool
    // The peer will notify when its roots change.
    roots_list_changed: Bool
    // The peer accepts `logging/setLevel` and emits log notifications.
    logging: Bool
    // The peer accepts elicitation — a server asking the user for
    // input through the client.
    elicitation: Bool
    // Capability names the peer declared that this package does not
    // know, kept rather than dropped so a caller can report what a
    // newer peer offered.
    unknown: [Str]

// Who the peer says it is.
pub struct AgpPeerInfo
    // The implementation's name.
    name: Str
    // Its version.
    version: Str
    // A human-readable title, when the negotiated revision has one.
    title: Str

// A connection's whole protocol state.
//
// Everything that decides what may be sent, in one value that goes in
// and comes out of every call.  No clock, no socket, no buffer: those
// are the host's, and this is what the host checks against.
pub struct AgpSession
    // Which end of the connection this value belongs to.
    side: agpwire.AgpSide
    // Where the connection is.
    state: AgpState
    // The protocol version agreed, or an empty string before
    // negotiation.
    version: Str
    // What the PEER said it can do.  Empty before `initialize` is
    // answered, which is why `may_send` refuses capability-gated
    // methods in every state before `AgpReady`.
    peer: AgpCapabilities
    // Who the peer says it is.
    peer_info: AgpPeerInfo
    // What THIS side declared, kept so a caller can answer a peer's
    // question about its own capabilities without storing them twice.
    own: AgpCapabilities
    // The ids of requests sent and not yet answered, in the order they
    // went out.
    //
    // Here so a response can be matched and a duplicate id refused —
    // not so anything can be timed out or retried, which needs a clock
    // this package does not have.
    outstanding: [agpwire.AgpId]

// ── Starting ─────────────────────────────────────────────────────────

// A fresh client session, with the capabilities this side offers.
pub fn client_session(own: AgpCapabilities) -> AgpSession []
    todo("agent-proto-nv.agpsession.client_session")

// A fresh server session.
pub fn server_session(own: AgpCapabilities) -> AgpSession []
    todo("agent-proto-nv.agpsession.server_session")

// No capabilities at all.
//
// What a minimal client declares, and the value a caller builds on
// with the `with_*` calls rather than writing twelve booleans.
pub fn no_capabilities() -> AgpCapabilities []
    todo("agent-proto-nv.agpsession.no_capabilities")

