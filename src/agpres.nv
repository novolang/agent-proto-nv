// The `resources/subscribe` request.
//
// Gated on the peer's `resources.subscribe` capability, which
// `agpsession.may_send` checks — a server that did not declare it will
// answer `-32601`, and asking first is cheaper.
pub fn subscribe_request(id: agpwire.AgpId, uri: Str) -> agpwire.AgpMessage []
    todo("agent-proto-nv.agpres.subscribe_request")

// The `resources/unsubscribe` request.
pub fn unsubscribe_request(id: agpwire.AgpId, uri: Str) -> agpwire.AgpMessage []
    todo("agent-proto-nv.agpres.unsubscribe_request")

// The `notifications/resources/updated` a server sends for a
// subscribed URI.
pub fn updated_notification(uri: Str) -> agpwire.AgpMessage []
    todo("agent-proto-nv.agpres.updated_notification")

// The URI in an updated notification.
pub fn updated_uri(params: JsonValueH) -> Str []
    todo("agent-proto-nv.agpres.updated_uri")

// The `notifications/resources/list_changed`.
pub fn list_changed_notification() -> agpwire.AgpMessage []
    todo("agent-proto-nv.agpres.list_changed_notification")

// ── Roots ────────────────────────────────────────────────────────────

// The `roots/list` request, which a SERVER sends to a CLIENT.
//
// The one place the direction inverts, and `agpwire.originator_of`
// answers `AgpServer` for it — so a client that sent it has met its
// own bug rather than a strange server.
pub fn roots_request(id: agpwire.AgpId) -> agpwire.AgpMessage []
    todo("agent-proto-nv.agpres.roots_request")

// The roots in a `roots/list` result.
pub fn roots_of(result: JsonValueH) -> Result<[AgpRoot], agperror.AgpFault> []
    todo("agent-proto-nv.agpres.roots_of")

// A `roots/list` result a client should answer with.
pub fn roots_result(id: agpwire.AgpId, roots: [AgpRoot]) -> agpwire.AgpMessage []
    todo("agent-proto-nv.agpres.roots_result")

// The `notifications/roots/list_changed` a client sends.
pub fn roots_changed_notification() -> agpwire.AgpMessage []
    todo("agent-proto-nv.agpres.roots_changed_notification")

// Whether a URI is inside one of the roots.
//
// THE CHECK A SERVER OWES ITS CLIENT.  Roots are the client saying
// which directories the server may work in, and a server that listed
// them and then read outside them has ignored the one permission
// mechanism the protocol has. Published here so the comparison —
// which is a prefix test on a normalised path, not on a string — is
// written once.
pub fn is_within_roots(roots: [AgpRoot], uri: Str) -> Bool []
    todo("agent-proto-nv.agpres.is_within_roots")

// The root a URI falls under, or nothing.
pub fn root_of(roots: [AgpRoot], uri: Str) -> ?AgpRoot []
    todo("agent-proto-nv.agpres.root_of")
